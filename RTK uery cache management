{
  api: {
    queries: {
      'getUserById(1)': {
        status: 'fulfilled',
        data: { id: 1, name: 'John' },
        fulfilledTimeStamp: 1693353600000,
        // ...
      }
    },
    mutations: {},
    provided: {
      User: ['getUserById(1)', 'getUserById(2)']
    },
